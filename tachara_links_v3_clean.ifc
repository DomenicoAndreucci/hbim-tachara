#155345=IFCPROPERTYSINGLEVALUE('HBIM_Inscription.ID',$,IFCTEXT('A3P'),$);
#155346=IFCPROPERTYSINGLEVALUE('HBIM_Inscription.Text_EN',$,IFCTEXT('A great god is Ahuramazda, who created this earth, who created that heaven, who created humankind, who created well\X2\2011\X0\being for humankind, who made me, Artaxerxes, king \X2\2014\X0\ one man as king over many, one man as lord over many.\X2\000A000A\X0\Thus speaks Artaxerxes, the Great King, King of Kings, King of Lands, King of this earth: I am the son of King Artaxerxes (II); Artaxerxes was the son of King Darius (II); Darius was the son of King Artaxerxes (I); Artaxerxes was the son of King Xerxes; Xerxes was the son of King Darius (I); Darius was the son of one Hystaspes; Hystaspes was the son of one Arsames \X2\2014\X0\ an Achaemenid.\X2\000A000A\X0\Thus says King Artaxerxes: This stone terrace has been built by me for myself.\X2\000A000A\X0\Thus says King Artaxerxes: May Ahuramazda and the god Mithra protect me, and this land, and what has been built by me.'),$);
#155347=IFCPROPERTYSINGLEVALUE('HBIM_Inscription.Reference',$,IFCTEXT('Weissbach, F.H. (1911) Die Keilinschriften der Ach\X2\00E4\X0\meniden. Leipzig: J. C. Hinrichs.'),$);
